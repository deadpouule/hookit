# Private key used by DeployBaseSepolia.s.sol / MineHookAddress.s.sol
PRIVATE_KEY=

# RPC (defaults to https://sepolia.base.org if unset)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# BaseScan API key — used by forge verify-contract and auto-verify after each launch
BASESCAN_API_KEY=

# Protocol operator / treasury (receives 20% of protocol revenue)
OPS_TREASURY=

# Optional CREATE2 salt override if already mined
HOOK_SALT=
