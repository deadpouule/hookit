# Private key used by deploy scripts
PRIVATE_KEY=

# --- Networks ---
# Production mainnet: Ink (57073). Universal Router v4 is live on Ink mainnet.
INK_RPC_URL=https://rpc-gel.inkonchain.com
INK_RPC_URL_BACKUP=https://rpc-qnd.inkonchain.com
# Optional server-only paid/third RPC. Prefer INDEXER_RPC_URLS for explicit ordering.
INK_RPC_URL_TERTIARY=
# Ink Sepolia (763373) has no v4 Universal Router — do not use for Hookit integration tests.
INK_SEPOLIA_RPC_URL=https://rpc-gel-sepolia.inkonchain.com

# Integration testnet: Base Sepolia (84532) — mirrors v4 hook/router behavior.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Explorer API keys (forge verify-contract)
INK_EXPLORER_API_KEY=
BASESCAN_API_KEY=

# Protocol operator / treasury (receives 20% of protocol revenue)
OPS_TREASURY=

# Optional CREATE2 salt override if already mined
HOOK_SALT=

# --- Soft launch (Ink) — live deploy: deploy/ink/addresses.json + SOFT_LAUNCH_INK.md ---
# Copy deploy/ink/env.ink.example → .env and add PRIVATE_KEY for scripts.
# Verify: forge script script/VerifyInkDeploy.s.sol --rpc-url $INK_RPC_URL -vv
# Harden: forge script script/HardenInkSoftLaunch.s.sol --rpc-url $INK_RPC_URL --broadcast
# Dry-run: forge script script/DryRunInk.s.sol --fork-url $INK_RPC_URL --disable-code-size-limit -vv
# Native token fair-launch branding (Ink test deploy defaults to HOOKTEST):
# NATIVE_TOKEN_NAME=HOOKTEST
# NATIVE_TOKEN_SYMBOL=HTST
# NATIVE_TOKEN_URI=ipfs://hooktest-native

# --- Web (see web/.env.example) ---
# NEXT_PUBLIC_HOOKIT_CHAIN=ink
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# NEXT_PUBLIC_PRIVY_APP_ID=
