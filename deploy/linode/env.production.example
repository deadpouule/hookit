# Copy to /opt/hookit/.env on the Linode (chmod 600). Never commit secrets.

# --- Ink RPC (public gel — no Alchemy required) ---
INK_RPC_URL=https://rpc-gel.inkonchain.com

# --- Deployed factories (57073) ---
LAUNCH_FACTORY=
BONDING_FACTORY=
NEXT_PUBLIC_LAUNCH_FACTORY=
NEXT_PUBLIC_BONDING_FACTORY=
NEXT_PUBLIC_HOOKIT_SWAP_ROUTER=

# --- Indexer ---
INDEXER_START_BLOCK=
INDEXER_DATA_DIR=/var/lib/hookit-indexer
INDEXER_PORT=8787
INDEXER_POLL_MS=4000
INDEXER_CHUNK=800
INDEXER_CONFIRMATIONS=12

# --- Web (Next.js reads web/.env.production.local — deploy.sh syncs from here) ---
NEXT_PUBLIC_HOOKIT_CHAIN=ink
NEXT_PUBLIC_INK_RPC_URL=https://rpc-gel.inkonchain.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
INDEXER_URL=http://127.0.0.1:8787
HOOKIT_REPO_ROOT=/opt/hookit
PORT=3000
HOSTNAME=127.0.0.1

# --- Custom hook deploy (/api/hooks/deploy) — dedicated hot wallet, minimal Ink ETH ---
PRIVATE_KEY=
INK_EXPLORER_API_KEY=

# --- Optional: token images at launch ---
# PINATA_JWT=

# --- Optional: ops (not used by web/indexer runtime) ---
# OPS_TREASURY=
