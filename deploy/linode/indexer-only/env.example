# Copy to /opt/hookit/.env on the Linode (chmod 600). See env.production for full template.

HOOKIT_CHAIN=ink
INK_RPC_URL=https://rpc-gel.inkonchain.com
INK_RPC_URL_BACKUP=https://rpc-qnd.inkonchain.com

LAUNCH_FACTORY=0x54027828C6475d8FEeAB4fd81A7F79963bD7ed37
BONDING_FACTORY=0x4536B2fa48E6f81CdA1296AE87f288d20df610a4
POOL_MANAGER=0x360e68faccca8ca495c1b759fd9ee466db9fb32
NATIVE_TOKEN=0xF91BAaB0043bE02c5a1774ed837eaFEA3b283f38
PROTOCOL_DISTRIBUTOR=0x91Ef75507E7154FBC09c2a6BF45Af3fdd25EB815
HKIT_BUYBACK=0x72b798F9AB2545D476424a8870Ab13F59AEE669b
MULTI_PAIR_ARB_EXECUTOR=0xF5D87eaE49A40723C15196A71F1d9b506eF5bA50

FEE_KEEPER_PRIVATE_KEY=
INDEXER_START_BLOCK=56151088
INDEXER_DATA_DIR=/var/lib/hookit-indexer
INDEXER_PORT=8787
INDEXER_POLL_MS=12000
INDEXER_CHUNK=800
INDEXER_CONFIRMATIONS=12

FEE_KEEPER_DISTRIBUTE_REVENUE=true
FEE_KEEPER_BUYBACK=true
FEE_KEEPER_STOCK_SLIPPAGE_BPS=300
FEE_KEEPER_BUYBACK_MAX_WEI=50000000000000000
FEE_KEEPER_BUYBACK_MIN_WEI=1000000000000

HOOKIT_SWAP_ROUTER=0xf94e301607344B1B10ED1FE1A5099e92Cb76F362
MULTI_PAIR_ARB=true
MULTI_PAIR_ARB_DRY_RUN=false
MULTI_PAIR_ARB_PREFUND_USDG=true
# Transfer keeper wStock to executor when cheap leg; skip USDG→wStock if Quotrons pool at tick bound.
MULTI_PAIR_ARB_KEEPER_STOCK_DUST=1000000000000000
# Recycle executor + keeper wStock → USDG after each arb (required for serial prefunds).
MULTI_PAIR_ARB_SWEEP_USDG=true
NEXT_PUBLIC_NATIVE_TOKEN=0xF91BAaB0043bE02c5a1774ed837eaFEA3b283f38
NATIVE_TOKEN_LAUNCH_ID=1
