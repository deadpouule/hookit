# Copy to /opt/hookit/.env on the Linode (chmod 600). Indexer-only — no web secrets.

# --- Ink RPC ---
INK_RPC_URL=https://rpc-gel.inkonchain.com
HOOKIT_CHAIN=ink

# --- Factories (57073) — from your deploy ---
LAUNCH_FACTORY=
BONDING_FACTORY=

# --- Indexer (required for prod sync) ---
INDEXER_START_BLOCK=
INDEXER_DATA_DIR=/var/lib/hookit-indexer
INDEXER_PORT=8787
INDEXER_POLL_MS=12000
INDEXER_CHUNK=800
INDEXER_CONFIRMATIONS=12

# Optional: cap Node heap on 1 GB (uncomment if OOM)
# NODE_OPTIONS=--max-old-space-size=384
