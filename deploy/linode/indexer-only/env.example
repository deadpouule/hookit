# Copy to /opt/hookit/.env on the Linode (chmod 600). Indexer-only — no web secrets.

# --- Ink RPC (primary + backup; viem fallback on stall / 429) ---
INK_RPC_URL=https://rpc-gel.inkonchain.com
INK_RPC_URL_BACKUP=https://rpc-qnd.inkonchain.com
HOOKIT_CHAIN=ink

# --- Factories (57073) — deploy/ink/addresses.json ---
# Current cohabitation stack first, followed by both factories that still own live tokens.
LAUNCH_FACTORY=0x480bfb88985fb94f4345ed4bb2ec267db9ab9626,0x10c4687b66fec64066c59a59cae1a9c326779f35,0xbadb0cbffc80b107082babab9e488bc6bef8f425
BONDING_FACTORY=0x13d6216a92b013daacd36e4f6d78ad9264af1a0c

# --- Indexer (required for prod sync) ---
INDEXER_START_BLOCK=55204587
INDEXER_DATA_DIR=/var/lib/hookit-indexer
INDEXER_PORT=8787
INDEXER_POLL_MS=12000
INDEXER_CHUNK=800
INDEXER_CONFIRMATIONS=12

# Optional: cap Node heap on 1 GB (uncomment if OOM)
# NODE_OPTIONS=--max-old-space-size=384

# --- Daily fee keeper (systemd timer hookit-fee-keeper.timer) ---
# Dedicated gas wallet recommended. See deploy/linode/fee-keeper/README.md
# FEE_KEEPER_PRIVATE_KEY=0x...
PROTOCOL_DISTRIBUTOR=0x4149509d2293a61cb199e17227740eebfadd30c6
HKIT_BUYBACK=0x3d68cc2c71f3b146295c8d9c1a82b3591f24fccb
FEE_KEEPER_BUYBACK=true
FEE_KEEPER_BUYBACK_MAX_WEI=50000000000000000
FEE_KEEPER_BUYBACK_MIN_WEI=1000000000000
