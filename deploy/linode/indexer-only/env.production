# =============================================================================
# Hookit — canonical indexer + keepers env (Ink 57073)
#
# Linode:  cp deploy/linode/indexer-only/env.production /opt/hookit/.env
# Local:  cp deploy/linode/indexer-only/env.production indexer/.env
#          → set INDEXER_DATA_DIR=./data for local dev
#
# Then paste secrets (PRIVATE_KEY, FEE_KEEPER_PRIVATE_KEY, RPC keys):
#   chmod 600 .env && chown hookit:hookit .env   # Linode only
# =============================================================================

HOOKIT_CHAIN=ink

# --- RPC (indexer uses full list; keepers use first entry via INDEXER_RPC_URLS) ---
# Paid primary → Alchemy backup → public Ink tertiary.
INDEXER_RPC_URLS=https://lb.drpc.live/ink/YOUR_DRPC_KEY,https://ink-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY,https://rpc-gel.inkonchain.com
INK_RPC_URL=https://lb.drpc.live/ink/YOUR_DRPC_KEY
INK_RPC_URL_BACKUP=https://ink-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
INK_RPC_URL_TERTIARY=https://rpc-gel.inkonchain.com

# --- Indexer ---
INDEXER_DATA_DIR=/var/lib/hookit-indexer
INDEXER_PORT=8787
INDEXER_BIND=127.0.0.1
INDEXER_POLL_MS=4000
INDEXER_CHUNK=800
INDEXER_CONFIRMATIONS=12
INDEXER_START_BLOCK=55929992
# INDEXER_EXCLUDE=0x...

# --- Ink protocol (deploy/ink/addresses.json, 2026-09-14) ---
POOL_MANAGER=0x360E68faCcca8cA495c1B759Fd9EEe466db9FB32
LAUNCH_FACTORY=0x5709aa29ed27ff098e76378999c9b0cde42b83e0
LAUNCH_FACTORY_QUERY=0x58b038697b27ae16efaebb200c6ba86d28fa42d9
BONDING_FACTORY=0xa629619d516be82308dbdb12a4ca324c44ea9c67
HOOKIT_SWAP_ROUTER=0x718dab9d61eeee18c11399598254f2cc59f95da9
CLAIMS_REDEEMER=0xd95458005acd7aa90823543f43b30f3a4b7af057
MASTER_LAUNCH_HOOK=0x1d721a40b28bb4b01f6a327ba698ca247e902ac8
GRADUATED_FEE_HOOK=0x9af5aa686071f623033fabe232d33c263a73a088
FLOOR_VAULT=0x21deca4e088e4368e867fa775c6099ca23b5643b
FEE_ESCROW=0xd3e82504cb2a65a5af4df8aca38b21a79f7b2b7a
DISTRIBUTOR=0xcc6f74989f8400751eb77421e0bdcc280b58a608
PROTOCOL_DISTRIBUTOR=0xcc6f74989f8400751eb77421e0bdcc280b58a608
BUYBACK_VAULT=0x8784607077a387b490262d598159a406230eb111
HOLDER_AIRDROP_VAULT=0x366c7d252f89ac57c9415b947b203d81136ba455
HKT_HOLDER_DROP_VAULT=0x45e32e44871428bcbe9e27caa148b2e51f77379e
FEE_ETH_RAIL=0x6de73f59d5b7061da18fcede527f995a4ca7bba7
HKIT_BUYBACK=0xa3820e552d6c61650ce8b9b76306385271fdc736
MULTI_PAIR_ARB_EXECUTOR=0x3b726f9f906e225cbddba777844317a5793ec0d5
NATIVE_TOKEN=0x964ce443c5e111ea1b87a70166c6894af3eddb08
NATIVE_TOKEN_NAME=HOOKTEST
NATIVE_TOKEN_SYMBOL=HTEST
NATIVE_TOKEN_URI=ipfs://hooktest-native
OPS_TREASURY=0x67B436693b7f8ebAD6b1B1Caf88C2E197d961614

# --- Web / Vercel parity (optional on Linode; used if you run Next on same host) ---
NEXT_PUBLIC_HOOKIT_CHAIN=ink
NEXT_PUBLIC_INK_RPC_URL=https://rpc-gel.inkonchain.com
NEXT_PUBLIC_LAUNCH_FACTORY=0x5709aa29ed27ff098e76378999c9b0cde42b83e0
NEXT_PUBLIC_LAUNCH_FACTORY_QUERY=0x58b038697b27ae16efaebb200c6ba86d28fa42d9
NEXT_PUBLIC_BONDING_FACTORY=0xa629619d516be82308dbdb12a4ca324c44ea9c67
NEXT_PUBLIC_HOOKIT_SWAP_ROUTER=0x718dab9d61eeee18c11399598254f2cc59f95da9
NEXT_PUBLIC_CLAIMS_REDEEMER=0xd95458005acd7aa90823543f43b30f3a4b7af057
NEXT_PUBLIC_PROTOCOL_DISTRIBUTOR=0xcc6f74989f8400751eb77421e0bdcc280b58a608
NEXT_PUBLIC_HKIT_BUYBACK=0xa3820e552d6c61650ce8b9b76306385271fdc736
NEXT_PUBLIC_NATIVE_TOKEN=0x964ce443c5e111ea1b87a70166c6894af3eddb08
INDEXER_URL=https://indexer.hookit.fun

# --- Secrets (never commit real values) ---
PRIVATE_KEY=0xYOUR_PRIVATE_KEY
FEE_KEEPER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
INK_EXPLORER_API_KEY=YOUR_INK_EXPLORER_API_KEY

# --- Oracle keeper (systemd: hookit-oracle-keeper.timer, every 15 min) ---
# FEE_KEEPER_ORACLE_ONLY=true   # set by systemd unit, not in .env

# --- Fee keeper (systemd: hookit-fee-keeper.timer, daily 00:20 UTC) ---
FEE_KEEPER_DISTRIBUTE_REVENUE=true
FEE_KEEPER_BUYBACK=true
FEE_KEEPER_STOCK_SLIPPAGE_BPS=300
FEE_KEEPER_BUYBACK_MAX_WEI=50000000000000000
FEE_KEEPER_BUYBACK_MIN_WEI=1000000000000
FEE_KEEPER_SYNC_ORACLE=false
# FEE_KEEPER_DRY_RUN=false

# --- HTEST holder sync (systemd: hookit-hkt-sync-keeper.timer, hourly) ---
HKT_HOLDER_DROP_VAULT=0x45e32e44871428bcbe9e27caa148b2e51f77379e
INDEXER_URL=https://indexer.hookit.fun
HKT_SYNC_BATCH_SIZE=80
# HKT_SYNC_DRY_RUN=false

# --- Arb keeper (systemd: hookit-arb-keeper.timer, every 5 min) ---
MULTI_PAIR_ARB=true
MULTI_PAIR_ARB_DRY_RUN=false
MULTI_PAIR_ARB_AUTO=true
# Optional manual filter (overrides auto-scan when set):
# MULTI_PAIR_ARB_LAUNCH_IDS=2,3

# =============================================================================
# After editing:
#   sudo systemctl restart hookit-indexer
#   sudo systemctl enable --now hookit-oracle-keeper.timer hookit-fee-keeper.timer
#   sudo install -m 644 deploy/linode/systemd/hookit-arb-keeper.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now hookit-arb-keeper.timer
#
# On-chain still required before buyback/arb execute live:
#   Wire HTST 0x964c… on distributor + HkitBuyback
#   arbExecutor.setPaused(false), hook.setArbActive(true), setOperator(keeper)
# =============================================================================
