[Unit]
Description=Hookit multi-pair arb keeper (Ink)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hookit
Group=hookit
WorkingDirectory=/opt/hookit/indexer
EnvironmentFile=/opt/hookit/.env
ExecStart=/opt/hookit/deploy/linode/arb-keeper/run.sh
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hookit-arb-keeper

# Ranking + USDG swaps + execute can exceed systemd's 90s oneshot default.
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
