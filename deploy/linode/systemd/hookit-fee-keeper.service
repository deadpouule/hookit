[Unit]
Description=Hookit protocol fee keeper (Ink) — distribute pending + TWAP HTST buyback
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hookit
Group=hookit
WorkingDirectory=/opt/hookit/indexer
EnvironmentFile=/opt/hookit/.env
ExecStart=/opt/hookit/deploy/linode/fee-keeper/run.sh
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hookit-fee-keeper

# Allow slow RPC / multi-tx flush
TimeoutStartSec=900
