# Prefer HOOKIT_CHAIN; NEXT_PUBLIC_HOOKIT_CHAIN also works if you share web/.env.local
# Soft-launch: switch to ink only after factories are deployed (see SOFT_LAUNCH_INK.md)
HOOKIT_CHAIN=ink
# Legacy integration: HOOKIT_CHAIN=baseSepolia

# RPC — primary + backup (viem fallback). Official Ink: gel (Gelato) → qnd (QuickNode).
INK_RPC_URL=https://rpc-gel.inkonchain.com
INK_RPC_URL_BACKUP=https://rpc-qnd.inkonchain.com
INK_RPC_URL_TERTIARY=
# Or comma-separated list (overrides primary/backup):
# Put a paid RPC first in production, then both public fallbacks:
# INDEXER_RPC_URLS=https://paid-provider.example/key,https://rpc-gel.inkonchain.com,https://rpc-qnd.inkonchain.com
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Ink mainnet (57073) — deploy/ink/addresses.json
# Active (patched airdrop vault) first, then previous factory that still owns live tokens.
# The indexer also bakes both Ink factories in; this documents the pair.
LAUNCH_FACTORY=0x4ac6815a8628576078474025407b6d0317c919a7,0x480bfb88985fb94f4345ed4bb2ec267db9ab9626,0x10c4687b66fec64066c59a59cae1a9c326779f35,0xbadb0cbffc80b107082babab9e488bc6bef8f425
BONDING_FACTORY=0x04d6b9ca57b6f655bf3e2d4a4fa1d51a88f1ee42

POOL_MANAGER=0x360E68faCcca8cA495c1B759Fd9EEe466db9FB32
INDEXER_PORT=8787
INDEXER_POLL_MS=12000
INDEXER_CHUNK=2000
INDEXER_CONFIRMATIONS=12

# REQUIRED on soft launch: factory deploy block (avoids 80k lookback)
INDEXER_START_BLOCK=55204587
# INDEXER_DATA_DIR=./data
# Comma-separated addresses excluded from holder rankings (locker, etc.)
# INDEXER_EXCLUDE=0x...
