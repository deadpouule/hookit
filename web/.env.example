# Base Sepolia RPC (optional — defaults to https://sepolia.base.org)
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Set after running DeployBaseSepolia.s.sol on Base Sepolia
NEXT_PUBLIC_LAUNCH_FACTORY=

# Optional production swap router (defaults to Uniswap PoolSwapTest on Base Sepolia)
NEXT_PUBLIC_SWAP_ROUTER=

# Contract verification (LaunchToken + custom hook) reads BASESCAN_API_KEY
# from the repo-root .env — not this file.
