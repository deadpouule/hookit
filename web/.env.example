# Chain: ink (production) | baseSepolia (legacy integration tests only)
NEXT_PUBLIC_HOOKIT_CHAIN=ink
# Public Ink RPC (gel primary, qnd backup) — set in root .env as INK_RPC_URL / INK_RPC_URL_BACKUP
NEXT_PUBLIC_INK_RPC_URL=https://rpc-gel.inkonchain.com
NEXT_PUBLIC_INK_RPC_URL_BACKUP=https://rpc-qnd.inkonchain.com
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# WalletConnect Cloud project id — https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Ink mainnet (57073) — see deploy/ink/addresses.json
NEXT_PUBLIC_LAUNCH_FACTORY=0x10c4687b66fec64066c59a59cae1a9c326779f35
NEXT_PUBLIC_LAUNCH_FACTORY_QUERY=0x2b0f0c047e4520cefac3f8d8ff7073b7d15afa57
NEXT_PUBLIC_HOOKIT_SWAP_ROUTER=0x4c311c07085029be4973b5e7e1370ef70c244704
NEXT_PUBLIC_BONDING_FACTORY=0x44dd5e6fbd3594f7c784b76f8362d6e68b16af98
# Alias also accepted by config:
# NEXT_PUBLIC_SWAP_ROUTER=

# Local dev always uses the demo catalog (no on-chain RPC). Live sync is production-only.

# House indexer (local: npm run serve in indexer/ — see indexer/README.md)
INDEXER_URL=http://127.0.0.1:8787
# Production hosted indexer (charts / trades / holders):
# INDEXER_URL=https://indexer.hookit.fun

# Protocol stats (Ink deploy)
NEXT_PUBLIC_PROTOCOL_DISTRIBUTOR=0x302e52f0252360325796b7eb6a03409de40266ac
NEXT_PUBLIC_HKIT_BUYBACK=0xaf8fac4edfddc7446e8eb6282eb04163645b6fd9
NEXT_PUBLIC_NATIVE_TOKEN=0x9403cc96dbc7a63bbd5af65123653acd6938f688

# Optional: Pinata JWT for token image IPFS uploads at launch
# PINATA_JWT=
# NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs

# Optional monitoring (production)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# See SOFT_LAUNCH_INK.md for the Ink go checklist.
