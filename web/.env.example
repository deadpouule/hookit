# Chain: ink (production) | baseSepolia (legacy integration tests only)
NEXT_PUBLIC_HOOKIT_CHAIN=ink
# Server-only RPCs. Browser reads use the constrained same-origin /api/rpc/ink
# proxy, so provider credentials must never use a NEXT_PUBLIC_ prefix.
INK_RPC_URL=https://rpc-gel.inkonchain.com
INK_RPC_URL_BACKUP=https://rpc-qnd.inkonchain.com
INK_RPC_URL_TERTIARY=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# WalletConnect Cloud project id — https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Privy — email / Google / Twitter embedded wallets. Continue-with-wallet stays RainbowKit.
# Create an app at https://dashboard.privy.io , enable Email + Google + Twitter (not wallet login),
# add localhost:3000 and hookit.fun to allowed domains, then paste the App ID.
NEXT_PUBLIC_PRIVY_APP_ID=

# Ink mainnet (57073) — see deploy/ink/addresses.json
NEXT_PUBLIC_LAUNCH_FACTORY=0x5709aa29ed27ff098e76378999c9b0cde42b83e0
NEXT_PUBLIC_LAUNCH_FACTORY_QUERY=0x58b038697b27ae16efaebb200c6ba86d28fa42d9
NEXT_PUBLIC_HOOKIT_SWAP_ROUTER=0x718dab9d61eeee18c11399598254f2cc59f95da9
NEXT_PUBLIC_BONDING_FACTORY=0xa629619d516be82308dbdb12a4ca324c44ea9c67
# Alias also accepted by config:
# NEXT_PUBLIC_SWAP_ROUTER=

# Local dev always uses the demo catalog (no on-chain RPC). Live sync is production-only.

# House indexer (local: npm run serve in indexer/ — see indexer/README.md)
INDEXER_URL=http://127.0.0.1:8787
# Production hosted indexer (charts / trades / holders):
# INDEXER_URL=https://indexer.hookit.fun

# Protocol stats (Ink deploy)
NEXT_PUBLIC_PROTOCOL_DISTRIBUTOR=0xcc6f74989f8400751eb77421e0bdcc280b58a608
NEXT_PUBLIC_HKIT_BUYBACK=0xa3820e552d6c61650ce8b9b76306385271fdc736
NEXT_PUBLIC_NATIVE_TOKEN=0x964ce443c5e111ea1b87a70166c6894af3eddb08
# Patched MasterLaunchHook is live — wizard should not warn about snipe tax on factory-routed dev buys.
NEXT_PUBLIC_DEV_BUY_SNIPE_EXEMPT=1

# Optional: Pinata JWT for token image IPFS uploads at launch
# PINATA_JWT=
# NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs

# Optional monitoring (production)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# See SOFT_LAUNCH_INK.md for the Ink go checklist.
NEXT_PUBLIC_CLAIMS_REDEEMER=0xd95458005acd7aa90823543f43b30f3a4b7af057

# TradingView Advanced Charts (token candle chart, same widget as Tsunami).
# Licensed by TradingView — request access at https://www.tradingview.com/advanced-charts/
# then create a GitHub token that can read the private `tradingview/charting_library` repo.
# `npm run build` downloads `charting_library/` into web/public/ (gitignored) when set;
# without it the token page falls back to the in-house lightweight chart.
# TV_CHARTING_LIBRARY_TOKEN=
# TV_CHARTING_LIBRARY_REPO=tradingview/charting_library
# TV_CHARTING_LIBRARY_REF=master
