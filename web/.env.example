# Chain: ink (production) | baseSepolia (integration)
# Soft-launch Ink: set chain=ink only AFTER DeployHookitCore + paste addresses below.
NEXT_PUBLIC_HOOKIT_CHAIN=baseSepolia
NEXT_PUBLIC_INK_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# WalletConnect Cloud project id — https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Set after deploy (Ink soft launch needs all three)
NEXT_PUBLIC_LAUNCH_FACTORY=
NEXT_PUBLIC_HOOKIT_SWAP_ROUTER=
NEXT_PUBLIC_BONDING_FACTORY=
# Alias also accepted by config:
# NEXT_PUBLIC_SWAP_ROUTER=

# House indexer (charts / trades / holders). Start: cd ../indexer && npm run serve
INDEXER_URL=http://127.0.0.1:8787

# Optional: Pinata JWT for token image IPFS uploads at launch
# PINATA_JWT=
# NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs

# Optional monitoring (production)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# See SOFT_LAUNCH_INK.md for the Ink go checklist.
